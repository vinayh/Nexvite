/**
 * Template for the real wrangler.jsonc, which is gitignored because it holds
 * deployment-specific ids. Copy this file to wrangler.jsonc, fill in your
 * values, then run `npm run cf-typegen` to regenerate worker-configuration.d.ts
 * (also gitignored). CI copies this file verbatim; keep it valid.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexvite",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-18",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Non-secret config only; secrets live in .dev.vars / `wrangler secret put`.
	"vars": {
		// Space subdomain in https://{sub}.spaces.nexudus.com
		"NEXUDUS_SUBDOMAIN": "your-space",
		// The space's location id (GET /api/public/businesses/all)
		"NEXUDUS_BUSINESS_ID": "1000000000",
		// The modal's arrival pickers are labeled with this timezone and read as
		// its wall-clock, and messages display arrival times in it;
		// ExpectedArrival is sent as UTC (AGENTS). Tests assert Europe/London;
		// leave it if you run the suite.
		"SPACE_TIMEZONE": "Europe/London",
		// Registration log channel (id or #name); the bot must be invited to it.
		// Change it here and redeploy; empty disables the channel log.
		"VISITOR_CHANNEL": "#visitor-requests"
	},
	// Live, auto-rotating Nexudus auth record {username, access_token,
	// refresh_token}. Seeding: README, Deploying.
	"kv_namespaces": [
		{ "binding": "TOKENS", "id": "00000000000000000000000000000000" }
	],
	// Per-IP rate limit ahead of the HMAC work (workers.dev has no zone, so no
	// WAF rules). namespace_id is an arbitrary per-Worker integer.
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
	]
}
