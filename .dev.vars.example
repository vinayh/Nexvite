# Template for `.dev.vars` — copy to `.dev.vars` and fill in real values (that file is gitignored).
# These are the SECRET values, injected for `wrangler dev` locally and via
# `wrangler secret put <NAME>` in production. Non-secret config lives in wrangler.jsonc `vars`.

# Service member account used to authenticate to the Nexudus API (no 2FA).
NEXUDUS_USERNAME="service-account@example.com"
NEXUDUS_PASSWORD="change-me"

# Shared secret checked against the Slack request's X-Shared-Secret header.
# Generate with: openssl rand -hex 32
SLACK_SHARED_SECRET="change-me"
