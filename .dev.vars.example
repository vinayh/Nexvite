# Template for `.dev.vars` — copy to `.dev.vars` and fill in real values (that file is gitignored).
# These are the SECRET values, injected for `wrangler dev` locally and via
# `wrangler secret put <NAME>` in production. Non-secret config lives in wrangler.jsonc `vars`.

# Nexudus account the Worker signs in with (must not have 2FA — SPEC.md §7).
NEXUDUS_USERNAME="service-account@example.com"
NEXUDUS_PASSWORD="change-me"

# Slack app credentials (Basic Information → Signing Secret; OAuth & Permissions
# → Bot User OAuth Token). Used to verify inbound requests and to open the modal
# / DM the result. See SPEC.md §12 for the app-setup steps.
SLACK_SIGNING_SECRET="change-me"
SLACK_BOT_TOKEN="xoxb-change-me"
